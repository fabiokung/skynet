# - Config file for the SkyNet package
# It defines the following variables
#  SKYNET_INCLUDE_DIRS - include directories for SkyNet
#  SKYNET_LIBRARIES    - libraries to link against

# Compute paths
get_filename_component(SKYNET_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
set(SKYNET_INCLUDE_DIRS "@SKYNET_INCLUDE_DIRS@")

# Our library dependencies (contains definitions for IMPORTED targets)
include("${SKYNET_CMAKE_DIR}/SkyNetTargets.cmake")

# These are IMPORTED targets created by SkyNetTargets.cmake
set(SKYNET_LIBRARIES SkyNet "@SKYNET_EXTERNAL_LIBS@")
set(SKYNET_STATIC_LIBRARIES SkyNet_static "@SKYNET_EXTERNAL_LIBS@")
